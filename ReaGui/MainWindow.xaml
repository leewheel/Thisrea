<Window x:Class="ReaGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReaGui.Views"
        Title="REA GUI"
        Width="1320" Height="860" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg0}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/app.png">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Background="{StaticResource Bg0}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= 标题栏 ================= -->
            <Grid Grid.Row="0" Background="{StaticResource Bg1}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Assets/app.png" Width="22" Height="22" Margin="0,0,10,0" />
                    <TextBlock Text="REA GUI -- GUI By Leewheel" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <Border Background="{StaticResource NeonGradient}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="逆向工作台" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF04121A" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="SettingsBtn" Content="⚙" FontFamily="Segoe UI Symbol" FontSize="16"
                            Width="44" Height="46" Style="{StaticResource CaptionButton}" Click="OnSettingsClick" ToolTip="设置" />
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="最小化">
                        <Path Data="M0,0 H11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1" SnapsToDevicePixels="True" />
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Click="OnMaxRestore" ToolTip="最大化">
                        <Path x:Name="MaxIcon" Data="M0,0 H10.5 V10.5 H0 Z" Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1" SnapsToDevicePixels="True" />
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource CloseCaptionButton}" Click="OnClose" ToolTip="关闭">
                        <Path Data="M0,0 L11,11 M0,11 L11,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1" SnapsToDevicePixels="True" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= 全局目标栏 ================= -->
            <Border Grid.Row="1" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="目标" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MonoTextBox}" ToolTip="待逆向的目标文件路径" />
                    <Button Grid.Column="2" Content="浏览…" Margin="8,0,0,0" Command="{Binding BrowseTargetCommand}" />

                    <TextBlock Grid.Column="3" Text="引擎" Foreground="{StaticResource TextMuted}" Margin="18,0,8,0" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding Provider}" />

                    <TextBlock Grid.Column="5" Text="快照" Foreground="{StaticResource TextMuted}" Margin="18,0,8,0" />
                    <TextBox Grid.Column="6" Text="{Binding SnapshotPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MonoTextBox}" ToolTip="可选：--snapshot 分析快照数据库" />
                </Grid>
            </Border>

            <!-- ================= 主体 ================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="188" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 导航 -->
                <Border Grid.Column="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="工作区" Style="{StaticResource SectionTitle}" Margin="16,16,16,4" />
                        <ListBox x:Name="NavList" ItemsSource="{Binding NavItems}" SelectionChanged="OnNavSelectionChanged"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource NavItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="15"
                                                   Width="22" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding Label}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 内容区（各页叠加，按 CurrentPage 显示） -->
                <Grid Grid.Column="1">
                    <views:AnalysisView Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter=Analysis}" />
                    <views:RunnerView Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter=Runner}" />
                    <views:EnvironmentView Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter=Environment}" />
                    <views:SettingsView Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter=Settings}" />
                </Grid>
            </Grid>

            <!-- ================= 状态栏 ================= -->
            <Border Grid.Row="3" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Busy}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="{Binding LastCommandLine}" Style="{StaticResource MonoText}"
                               Foreground="{StaticResource TextDim}" Margin="16,0" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" ToolTip="{Binding LastCommandLine}" />
                    <Button Grid.Column="3" Content="取消" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}"
                            Visibility="{Binding Busy, Converter={StaticResource BoolVis}}" Padding="12,3" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
