<Application x:Class="ReaGui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ReaGui.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:EnumToVisibilityConverter x:Key="EnumVis" />
            <conv:BoolToVisibilityConverter x:Key="BoolVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
